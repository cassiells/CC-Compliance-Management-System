<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CC Login</title>
    <link rel="icon" type="image/png" href="~/images/cc-logo-mark.png" />
    <link rel="stylesheet" href="~/css/docomply.css" asp-append-version="true" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    @RenderBody()
    <script src="~/js/docomply.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
