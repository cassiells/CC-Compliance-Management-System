<div id="confirmSignoutModal" class="dc-modal-backdrop">
    <div class="dc-modal-surface" style="max-width: 440px;">
        <div class="dc-modal-header">
            <h3 class="dc-modal-title">Sign out of CC?</h3>
            <button type="button" class="dc-modal-close" data-dc-modal-dismiss="confirmSignoutModal">
                <i data-lucide="x" style="width:18px; height:18px;"></i>
            </button>
        </div>
        <div class="dc-modal-body">
            <p class="dc-body-secondary">
                Are you sure you want to sign out? You will need to enter your account credentials to access CC again.
            </p>
        </div>
        <div class="dc-modal-footer">
            <button type="button" class="dc-btn dc-btn-secondary" data-dc-modal-dismiss="confirmSignoutModal">Cancel</button>
            <a href="/Account/Logout" class="dc-btn dc-btn-reject" style="background:#C62828; color:#FFFFFF; border-color:#C62828;">Sign out</a>
        </div>
    </div>
</div>
