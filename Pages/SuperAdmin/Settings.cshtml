@page
@model DoComply.Pages.SuperAdmin.SettingsModel
@{
    ViewData["Title"] = "System Settings";
}

<div class="dc-page-header">
    <div class="dc-page-title-group">
        <div class="dc-breadcrumb">
            <a href="/SuperAdmin/Overview">Super Admin</a> / <span>System Settings</span>
        </div>
        <h1 class="dc-h1">System Settings</h1>
        <p class="dc-body-secondary">Configure organization branding, support parameters, and notification defaults.</p>
    </div>
</div>

<!-- Saved Success Alert Banner -->
<div id="settingsSavedBanner" class="dc-card" style="display:none; background:#E6F4EA; border-color:#1F8A4C; padding:16px; margin-bottom:24px;">
    <div style="display:flex; align-items:center; gap:12px;">
        <i data-lucide="check-circle" style="color:#1F8A4C; width:24px; height:24px; flex-shrink:0;"></i>
        <div>
            <div style="font-weight:700; font-size:15px; color:#1F8A4C;">Settings saved</div>
            <div style="font-size:13px; color:#166534;">Your system configuration has been updated successfully.</div>
        </div>
    </div>
</div>

<form id="systemSettingsForm" onsubmit="handleSettingsSave(event)">
    <div class="dc-grid-12">
        <!-- Card 1: Organization Settings -->
        <div class="dc-col-6">
            <div class="dc-card" style="height:100%;">
                <div class="dc-card-header">
                    <h3 class="dc-card-title">Organization Identity</h3>
                    <i data-lucide="building" style="color:var(--dc-navy-primary); width:20px; height:20px;"></i>
                </div>

                <div class="dc-form-group">
                    <label class="dc-form-label">Organization Name</label>
                    <input type="text" id="settingsOrgName" class="dc-form-control" value="@Model.OrgName" oninput="updateOrgPreview()" required />
                    <span class="dc-form-helper">Displayed in top bar branding, documents, and notifications.</span>
                </div>

                <div class="dc-form-group">
                    <label class="dc-form-label">Support Email Address</label>
                    <input type="email" id="settingsSupportEmail" class="dc-form-control" value="@Model.SupportEmail" oninput="updateOrgPreview()" required />
                    <span class="dc-form-helper">Inquiries from suppliers and staff are routed to this address.</span>
                </div>

                <!-- Live Organization Preview -->
                <div style="margin-top:20px; padding:16px; background:#F8FAFC; border:1px solid var(--dc-border); border-radius:var(--dc-radius);">
                    <span class="dc-caption" style="font-weight:600; text-transform:uppercase; letter-spacing:0.04em; color:var(--dc-text-secondary); display:block; margin-bottom:8px;">
                        Live Organization Preview
                    </span>
                    <div style="display:flex; align-items:center; gap:12px;">
                        <div class="dc-logo-icon" style="width:36px; height:36px;">
                            <img src="~/images/cc-logo-transparent.png" alt="CC" />
                        </div>
                        <div>
                            <div id="previewOrgName" style="font-weight:700; font-size:14px; color:var(--dc-text-primary);">@Model.OrgName</div>
                            <div id="previewSupportEmail" style="font-size:12px; color:var(--dc-text-secondary);">@Model.SupportEmail</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Notification Settings -->
        <div class="dc-col-6">
            <div class="dc-card" style="height:100%;">
                <div class="dc-card-header">
                    <h3 class="dc-card-title">Notification Triggers</h3>
                    <i data-lucide="bell" style="color:var(--dc-navy-primary); width:20px; height:20px;"></i>
                </div>

                <div style="display:flex; flex-direction:column; gap:16px;">
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:#F8FAFC; border-radius:var(--dc-radius); border:1px solid var(--dc-border);">
                        <div>
                            <div style="font-weight:600; font-size:14px;">Expiration Reminders</div>
                            <div class="dc-caption">Notify suppliers 30 days prior to document expiration.</div>
                        </div>
                        <input type="checkbox" id="settingsReminders" style="width:20px; height:20px; accent-color:var(--dc-navy-primary);" checked />
                    </div>

                    <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:#F8FAFC; border-radius:var(--dc-radius); border:1px solid var(--dc-border);">
                        <div>
                            <div style="font-weight:600; font-size:14px;">Expired Document Alerts</div>
                            <div class="dc-caption">Flag expired documents immediately and update supplier status.</div>
                        </div>
                        <input type="checkbox" id="settingsAlerts" style="width:20px; height:20px; accent-color:var(--dc-navy-primary);" checked />
                    </div>

                    <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:#F8FAFC; border-radius:var(--dc-radius); border:1px solid var(--dc-border);">
                        <div>
                            <div style="font-weight:600; font-size:14px;">Verification Outcomes</div>
                            <div class="dc-caption">Send automated email notifications upon approval or rejection.</div>
                        </div>
                        <input type="checkbox" id="settingsOutcomes" style="width:20px; height:20px; accent-color:var(--dc-navy-primary);" checked />
                    </div>
                </div>
            </div>
        </div>

        <!-- Full-Width Bottom Save Panel -->
        <div class="dc-col-12" style="margin-top: 12px;">
            <div class="dc-card" style="background:#F8FAFC; border-color:var(--dc-navy-active); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;">
                <div>
                    <h3 style="font-size:16px; font-weight:600; color:var(--dc-navy-primary);">Apply system settings</h3>
                    <p class="dc-body-secondary">Changes take effect across CC after they are saved.</p>
                </div>
                <button type="submit" class="dc-btn dc-btn-primary dc-btn-lg">
                    <i data-lucide="save"></i> Save Settings
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function updateOrgPreview() {
            const org = document.getElementById('settingsOrgName').value || 'CC Corporation';
            const email = document.getElementById('settingsSupportEmail').value || 'support@cccorp.com';
            document.getElementById('previewOrgName').textContent = org;
            document.getElementById('previewSupportEmail').textContent = email;
        }

        function handleSettingsSave(e) {
            e.preventDefault();
            const banner = document.getElementById('settingsSavedBanner');
            banner.style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
            showToast('Settings saved successfully.');
        }
    </script>
}
