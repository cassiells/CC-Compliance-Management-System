@page
@model DoComply.Pages.Admin.ReportsModel
@using System.Text.Json
@{
    ViewData["Title"] = "Compliance Audit Reports & Analytics";

    var compJson = JsonSerializer.Serialize(Model.ComplianceReports.Select(r => new { 
        r.SupplierId, 
        r.SupplierName, 
        r.ComplianceStatus 
    }));

    var expJson = JsonSerializer.Serialize(Model.ExpiredReports.Select(r => new { 
        r.SupplierId, 
        r.SupplierName, 
        r.Document, 
        ExpiryDate = r.ExpiryDate.HasValue ? r.ExpiryDate.Value.ToString("yyyy-MM-dd") : "" 
    }));

    var expiringJson = JsonSerializer.Serialize(Model.ExpiringReports.Select(r => new { 
        r.SupplierId, 
        r.SupplierName, 
        r.Document, 
        ExpiryDate = r.ExpiryDate.HasValue ? r.ExpiryDate.Value.ToString("yyyy-MM-dd") : "" 
    }));
}

<div class="dc-page-header">
    <div class="dc-page-title-group">
        <div class="dc-breadcrumb">
            <a href="/Admin/Dashboard">Administrator</a> / <span>Reports</span>
        </div>
        <h1 class="dc-h1">Compliance Audit Reports &amp; Analytics</h1>
        <p class="dc-body-secondary">Comprehensive compliance analytics, document expiration tracking, and interactive reports for administrators.</p>
    </div>

    <div style="display:flex; align-items:center; gap:10px;">
        <button type="button" class="dc-btn dc-btn-secondary" onclick="exportCurrentReportCSV()">
            <i data-lucide="file-spreadsheet"></i> Export CSV
        </button>
        <button type="button" class="dc-btn dc-btn-primary" onclick="exportCurrentReportPDF()">
            <i data-lucide="file-text"></i> Export PDF (QuestPDF)
        </button>
    </div>
</div>

<style>
    .dc-tab-btn * { pointer-events: none; }
</style>

<!-- Report Navigation Tabs -->
<div class="dc-tabs">
    <button type="button" class="dc-tab-btn active" id="tabBtnCompliance" onclick="switchAdminTab('complianceTab', this)">
        <i data-lucide="bar-chart-2"></i> Compliance Report
        <span class="dc-tab-badge" id="badgeCompCount">@Model.TotalSuppliers</span>
    </button>
    <button type="button" class="dc-tab-btn" id="tabBtnExpired" onclick="switchAdminTab('expiredTab', this)">
        <i data-lucide="alert-octagon"></i> Expired Documents
        <span class="dc-tab-badge" id="badgeExpCount">@Model.TotalExpired</span>
    </button>
    <button type="button" class="dc-tab-btn" id="tabBtnExpiring" onclick="switchAdminTab('expiringTab', this)">
        <i data-lucide="clock"></i> Expiring Documents
        <span class="dc-tab-badge" id="badgeExpiringCount">@Model.TotalExpiring</span>
    </button>
</div>

<!-- ==========================================
     TAB 1: COMPLIANCE REPORT & ANALYTICS
     ========================================== -->
<div id="complianceTab" class="dc-admin-tab-pane">
    <!-- Filter Toolbar -->
    <div class="dc-card" style="margin-bottom: 20px; padding: 14px 18px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:14px; background:#FFFFFF;">
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:12px; flex:1;">
            <div class="dc-search-input-wrapper" style="max-width:320px; width:100%;">
                <i data-lucide="search" class="dc-search-icon" style="width:16px; height:16px;"></i>
                <input type="text" id="compSearchInput" class="dc-search-input" placeholder="Search supplier name…" oninput="filterComplianceReport()" />
            </div>

            <div style="display:flex; align-items:center; gap:8px;">
                <label for="compStatusFilter" style="font-size:13px; font-weight:600; color:var(--dc-text-secondary); white-space:nowrap;">Status Filter:</label>
                <select id="compStatusFilter" class="dc-form-control" style="width:180px; padding:7px 12px; height:38px;" onchange="filterComplianceReport()">
                    <option value="all">All Statuses (@Model.TotalSuppliers)</option>
                    <option value="Compliant">Compliant (@Model.CompliantCount)</option>
                    <option value="Not Compliant">Not Compliant (@Model.NotCompliantCount)</option>
                </select>
            </div>
        </div>

        <button type="button" class="dc-btn dc-btn-secondary dc-btn-sm" onclick="resetComplianceFilters()">
            <i data-lucide="rotate-ccw" style="width:14px; height:14px;"></i> Reset Filter
        </button>
    </div>

    <!-- KPI Metric Summary Cards -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:16px; margin-bottom:20px;">
        <div class="dc-card" style="padding:16px 20px; border-left:4px solid var(--dc-navy-primary);">
            <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--dc-text-secondary); margin-bottom:6px;">Total Evaluated</div>
            <div style="font-size:26px; font-weight:700; color:var(--dc-navy-primary);" id="compKpiTotal">@Model.TotalSuppliers</div>
            <div style="font-size:12px; color:var(--dc-text-muted); margin-top:4px;">Suppliers in network</div>
        </div>

        <div class="dc-card" style="padding:16px 20px; border-left:4px solid var(--dc-green-approve);">
            <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--dc-text-secondary); margin-bottom:6px;">Compliant Suppliers</div>
            <div style="font-size:26px; font-weight:700; color:var(--dc-green-approve);" id="compKpiCompliant">@Model.CompliantCount</div>
            <div style="font-size:12px; color:var(--dc-green-text); margin-top:4px;">All obligations valid</div>
        </div>

        <div class="dc-card" style="padding:16px 20px; border-left:4px solid var(--dc-red-reject);">
            <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--dc-text-secondary); margin-bottom:6px;">Non-Compliant</div>
            <div style="font-size:26px; font-weight:700; color:var(--dc-red-reject);" id="compKpiNonCompliant">@Model.NotCompliantCount</div>
            <div style="font-size:12px; color:var(--dc-red-text); margin-top:4px;">Missing / Expired items</div>
        </div>

        <div class="dc-card" style="padding:16px 20px; border-left:4px solid #3B82F6;">
            <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--dc-text-secondary); margin-bottom:6px;">Compliance Rate</div>
            <div style="font-size:26px; font-weight:700; color:#1E40AF;" id="compKpiRate">@Model.ComplianceRate%</div>
            <div style="font-size:12px; color:var(--dc-text-muted); margin-top:4px;">Network health benchmark</div>
        </div>
    </div>

    <!-- Chart.js Visual Analytics -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap:20px; margin-bottom:24px;">
        <div class="dc-card" style="padding:20px; background:#FFFFFF;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                <div style="font-weight:600; font-size:15px; color:var(--dc-text-primary); display:flex; align-items:center; gap:8px;">
                    <i data-lucide="pie-chart" style="width:18px; height:18px; color:var(--dc-navy-primary);"></i> Compliance Distribution
                </div>
                <span class="dc-caption" style="color:var(--dc-text-muted);">Real-time breakdown</span>
            </div>
            <div style="height:250px; position:relative;">
                <canvas id="chartComplianceDoughnut"></canvas>
            </div>
        </div>

        <div class="dc-card" style="padding:20px; background:#FFFFFF;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                <div style="font-weight:600; font-size:15px; color:var(--dc-text-primary); display:flex; align-items:center; gap:8px;">
                    <i data-lucide="bar-chart" style="width:18px; height:18px; color:var(--dc-navy-primary);"></i> Supplier Standing Comparison
                </div>
                <span class="dc-caption" style="color:var(--dc-text-muted);">Status Volume</span>
            </div>
            <div style="height:250px; position:relative;">
                <canvas id="chartComplianceBar"></canvas>
            </div>
        </div>
    </div>

    <!-- Paginated Data Table (Strict 8 items per page) -->
    <div class="dc-card" style="padding:0; overflow:hidden; background:#FFFFFF;">
        <div style="padding:16px 20px; border-bottom:1px solid var(--dc-border); display:flex; justify-content:space-between; align-items:center;">
            <h3 style="font-size:15px; font-weight:600; margin:0;">Supplier Compliance Records</h3>
            <span class="dc-caption" style="color:var(--dc-text-secondary); font-weight:500;" id="compTableInfo">Showing 1–8 of @Model.TotalSuppliers</span>
        </div>

        <div class="dc-table-container" style="border:none; border-radius:0;">
            <table class="dc-table" id="complianceTable">
                <thead>
                    <tr>
                        <th style="width:60%;">Supplier Name</th>
                        <th style="width:40%;">Compliance Standing</th>
                    </tr>
                </thead>
                <tbody id="complianceTableBody">
                    <!-- Populated via JavaScript pagination controller -->
                </tbody>
            </table>
        </div>

        <!-- Custom 8-Item Pagination Controls -->
        <div class="dc-pagination-bar" id="compPaginationBar" style="padding:12px 20px; border-top:1px solid var(--dc-border);">
            <div class="dc-pagination-info" id="compPageInfoText">Showing 1–8 of @Model.TotalSuppliers</div>
            <div class="dc-pagination-controls" id="compPageButtons"></div>
        </div>
    </div>
</div>

<!-- ==========================================
     TAB 2: EXPIRED DOCUMENTS REPORT & ANALYTICS
     ========================================== -->
<div id="expiredTab" class="dc-admin-tab-pane" style="display:none;">
    <!-- Filter Toolbar -->
    <div class="dc-card" style="margin-bottom: 20px; padding: 14px 18px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:14px; background:#FFFFFF;">
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:12px; flex:1;">
            <div class="dc-search-input-wrapper" style="max-width:320px; width:100%;">
                <i data-lucide="search" class="dc-search-icon" style="width:16px; height:16px;"></i>
                <input type="text" id="expiredSearchInput" class="dc-search-input" placeholder="Search supplier or document…" oninput="filterExpiredReport()" />
            </div>

            <div style="display:flex; align-items:center; gap:8px;">
                <label for="expiredDocFilter" style="font-size:13px; font-weight:600; color:var(--dc-text-secondary); white-space:nowrap;">Credential Filter:</label>
                <select id="expiredDocFilter" class="dc-form-control" style="width:200px; padding:7px 12px; height:38px;" onchange="filterExpiredReport()">
                    <option value="all">All Document Types (@Model.TotalExpired)</option>
                    <option value="Tax Clearance">Tax Clearance</option>
                    <option value="Safety Certificate">Safety Certificate</option>
                    <option value="Business Permit">Business Permit</option>
                </select>
            </div>
        </div>

        <button type="button" class="dc-btn dc-btn-secondary dc-btn-sm" onclick="resetExpiredFilters()">
            <i data-lucide="rotate-ccw" style="width:14px; height:14px;"></i> Reset Filter
        </button>
    </div>

    <!-- KPI Metric Summary Cards -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:20px;">
        <div class="dc-card" style="padding:16px 20px; border-left:4px solid var(--dc-red-reject);">
            <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--dc-text-secondary); margin-bottom:6px;">Total Expired Documents</div>
            <div style="font-size:26px; font-weight:700; color:var(--dc-red-reject);" id="expKpiTotal">@Model.TotalExpired</div>
            <div style="font-size:12px; color:var(--dc-red-text); margin-top:4px;">Immediate renewal required</div>
        </div>

        <div class="dc-card" style="padding:16px 20px; border-left:4px solid #F97316;">
            <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--dc-text-secondary); margin-bottom:6px;">Impacted Suppliers</div>
            <div style="font-size:26px; font-weight:700; color:#EA580C;" id="expKpiSuppliers">@Model.ExpiredSuppliersCount</div>
            <div style="font-size:12px; color:var(--dc-text-muted); margin-top:4px;">Unique non-compliant vendors</div>
        </div>

        <div class="dc-card" style="padding:16px 20px; border-left:4px solid var(--dc-navy-primary);">
            <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--dc-text-secondary); margin-bottom:6px;">Compliance Action</div>
            <div style="font-size:26px; font-weight:700; color:var(--dc-navy-primary);">Action Required</div>
            <div style="font-size:12px; color:var(--dc-text-muted); margin-top:4px;">Requires audit review &amp; re-upload</div>
        </div>
    </div>

    <!-- Chart.js Visual Analytics -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap:20px; margin-bottom:24px;">
        <div class="dc-card" style="padding:20px; background:#FFFFFF;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                <div style="font-weight:600; font-size:15px; color:var(--dc-text-primary); display:flex; align-items:center; gap:8px;">
                    <i data-lucide="file-x" style="width:18px; height:18px; color:var(--dc-red-reject);"></i> Expired by Credential Type
                </div>
                <span class="dc-caption" style="color:var(--dc-text-muted);">Breakdown</span>
            </div>
            <div style="height:250px; position:relative;">
                <canvas id="chartExpiredTypesBar"></canvas>
            </div>
        </div>

        <div class="dc-card" style="padding:20px; background:#FFFFFF;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                <div style="font-weight:600; font-size:15px; color:var(--dc-text-primary); display:flex; align-items:center; gap:8px;">
                    <i data-lucide="building" style="width:18px; height:18px; color:var(--dc-navy-primary);"></i> Top Impacted Suppliers
                </div>
                <span class="dc-caption" style="color:var(--dc-text-muted);">Non-compliant counts</span>
            </div>
            <div style="height:250px; position:relative;">
                <canvas id="chartExpiredSuppliersBar"></canvas>
            </div>
        </div>
    </div>

    <!-- Paginated Data Table (Strict 8 items per page) -->
    <div class="dc-card" style="padding:0; overflow:hidden; background:#FFFFFF;">
        <div style="padding:16px 20px; border-bottom:1px solid var(--dc-border); display:flex; justify-content:space-between; align-items:center;">
            <h3 style="font-size:15px; font-weight:600; margin:0;">Expired Documents Register</h3>
            <span class="dc-caption" style="color:var(--dc-text-secondary); font-weight:500;" id="expTableInfo">Showing 1–8 of @Model.TotalExpired</span>
        </div>

        <div class="dc-table-container" style="border:none; border-radius:0;">
            <table class="dc-table" id="expiredTable">
                <thead>
                    <tr>
                        <th style="width:40%;">Supplier Name</th>
                        <th style="width:30%;">Expired Document</th>
                        <th style="width:15%;">Expiration Date</th>
                        <th style="width:15%; text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody id="expiredTableBody">
                    <!-- Populated via JavaScript pagination controller -->
                </tbody>
            </table>
        </div>

        <!-- Custom 8-Item Pagination Controls -->
        <div class="dc-pagination-bar" id="expPaginationBar" style="padding:12px 20px; border-top:1px solid var(--dc-border);">
            <div class="dc-pagination-info" id="expPageInfoText">Showing 1–8 of @Model.TotalExpired</div>
            <div class="dc-pagination-controls" id="expPageButtons"></div>
        </div>
    </div>
</div>

<!-- ==========================================
     TAB 3: EXPIRING DOCUMENTS REPORT & ANALYTICS
     ========================================== -->
<div id="expiringTab" class="dc-admin-tab-pane" style="display:none;">
    <!-- Filter Toolbar -->
    <div class="dc-card" style="margin-bottom: 20px; padding: 14px 18px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:14px; background:#FFFFFF;">
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:12px; flex:1;">
            <div class="dc-search-input-wrapper" style="max-width:300px; width:100%;">
                <i data-lucide="search" class="dc-search-icon" style="width:16px; height:16px;"></i>
                <input type="text" id="expiringSearchInput" class="dc-search-input" placeholder="Search supplier or document…" oninput="filterExpiringReport()" />
            </div>

            <div style="display:flex; align-items:center; gap:8px;">
                <label for="expiringUrgencyFilter" style="font-size:13px; font-weight:600; color:var(--dc-text-secondary); white-space:nowrap;">Urgency:</label>
                <select id="expiringUrgencyFilter" class="dc-form-control" style="width:180px; padding:7px 12px; height:38px;" onchange="filterExpiringReport()">
                    <option value="all">All Horizons (@Model.TotalExpiring)</option>
                    <option value="critical">Critical (&le; 15 Days) (@Model.CriticalExpiringCount)</option>
                    <option value="upcoming">Upcoming (16–30 Days) (@Model.UpcomingExpiringCount)</option>
                </select>
            </div>

            <div style="display:flex; align-items:center; gap:8px;">
                <label for="expiringDocFilter" style="font-size:13px; font-weight:600; color:var(--dc-text-secondary); white-space:nowrap;">Credential:</label>
                <select id="expiringDocFilter" class="dc-form-control" style="width:180px; padding:7px 12px; height:38px;" onchange="filterExpiringReport()">
                    <option value="all">All Types</option>
                    <option value="Business Permit">Business Permit</option>
                    <option value="Tax Clearance">Tax Clearance</option>
                    <option value="Safety Certificate">Safety Certificate</option>
                </select>
            </div>
        </div>

        <button type="button" class="dc-btn dc-btn-secondary dc-btn-sm" onclick="resetExpiringFilters()">
            <i data-lucide="rotate-ccw" style="width:14px; height:14px;"></i> Reset Filter
        </button>
    </div>

    <!-- KPI Metric Summary Cards -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:20px;">
        <div class="dc-card" style="padding:16px 20px; border-left:4px solid #EAB308;">
            <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--dc-text-secondary); margin-bottom:6px;">Expiring Documents</div>
            <div style="font-size:26px; font-weight:700; color:#A16207;" id="expiringKpiTotal">@Model.TotalExpiring</div>
            <div style="font-size:12px; color:var(--dc-text-muted); margin-top:4px;">Within 30-day window</div>
        </div>

        <div class="dc-card" style="padding:16px 20px; border-left:4px solid var(--dc-red-reject);">
            <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--dc-text-secondary); margin-bottom:6px;">Critical (&le; 15 Days)</div>
            <div style="font-size:26px; font-weight:700; color:var(--dc-red-reject);" id="expiringKpiCritical">@Model.CriticalExpiringCount</div>
            <div style="font-size:12px; color:var(--dc-red-text); margin-top:4px;">High renewal priority</div>
        </div>

        <div class="dc-card" style="padding:16px 20px; border-left:4px solid #3B82F6;">
            <div style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--dc-text-secondary); margin-bottom:6px;">Upcoming (16–30 Days)</div>
            <div style="font-size:26px; font-weight:700; color:#1D4ED8;" id="expiringKpiUpcoming">@Model.UpcomingExpiringCount</div>
            <div style="font-size:12px; color:var(--dc-text-muted); margin-top:4px;">Advance notification dispatched</div>
        </div>
    </div>

    <!-- Chart.js Visual Analytics -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap:20px; margin-bottom:24px;">
        <div class="dc-card" style="padding:20px; background:#FFFFFF;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                <div style="font-weight:600; font-size:15px; color:var(--dc-text-primary); display:flex; align-items:center; gap:8px;">
                    <i data-lucide="pie-chart" style="width:18px; height:18px; color:#EAB308;"></i> Expiry Urgency Breakdown
                </div>
                <span class="dc-caption" style="color:var(--dc-text-muted);">Days remaining</span>
            </div>
            <div style="height:250px; position:relative;">
                <canvas id="chartExpiringUrgencyDoughnut"></canvas>
            </div>
        </div>

        <div class="dc-card" style="padding:20px; background:#FFFFFF;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                <div style="font-weight:600; font-size:15px; color:var(--dc-text-primary); display:flex; align-items:center; gap:8px;">
                    <i data-lucide="calendar" style="width:18px; height:18px; color:var(--dc-navy-primary);"></i> Expiring by Credential Type
                </div>
                <span class="dc-caption" style="color:var(--dc-text-muted);">Volume</span>
            </div>
            <div style="height:250px; position:relative;">
                <canvas id="chartExpiringTypesBar"></canvas>
            </div>
        </div>
    </div>

    <!-- Paginated Data Table (Strict 8 items per page) -->
    <div class="dc-card" style="padding:0; overflow:hidden; background:#FFFFFF;">
        <div style="padding:16px 20px; border-bottom:1px solid var(--dc-border); display:flex; justify-content:space-between; align-items:center;">
            <h3 style="font-size:15px; font-weight:600; margin:0;">Expiring Documents Schedule</h3>
            <span class="dc-caption" style="color:var(--dc-text-secondary); font-weight:500;" id="expiringTableInfo">Showing 1–8 of @Model.TotalExpiring</span>
        </div>

        <div class="dc-table-container" style="border:none; border-radius:0;">
            <table class="dc-table" id="expiringTable">
                <thead>
                    <tr>
                        <th style="width:35%;">Supplier Name</th>
                        <th style="width:25%;">Document Requirement</th>
                        <th style="width:15%;">Expiration Date</th>
                        <th style="width:15%;">Days Remaining</th>
                        <th style="width:10%; text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody id="expiringTableBody">
                    <!-- Populated via JavaScript pagination controller -->
                </tbody>
            </table>
        </div>

        <!-- Custom 8-Item Pagination Controls -->
        <div class="dc-pagination-bar" id="expiringPaginationBar" style="padding:12px 20px; border-top:1px solid var(--dc-border);">
            <div class="dc-pagination-info" id="expiringPageInfoText">Showing 1–8 of @Model.TotalExpiring</div>
            <div class="dc-pagination-controls" id="expiringPageButtons"></div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Load Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        // Pagination Limit Constant (Strictly fixed to 8 as requested)
        const ITEMS_PER_PAGE = 8;

        // Raw Server Data
        const rawComplianceData = @Html.Raw(compJson);
        const rawExpiredData = @Html.Raw(expJson);
        const rawExpiringData = @Html.Raw(expiringJson);

        // Active State
        let currentTabId = 'complianceTab';
        let filteredCompList = [...rawComplianceData];
        let filteredExpList = [...rawExpiredData];
        let filteredExpiringList = [...rawExpiringData];

        let compCurrentPage = 1;
        let expCurrentPage = 1;
        let expiringCurrentPage = 1;

        // Chart.js Instances
        let chartCompDoughnut = null;
        let chartCompBar = null;
        let chartExpTypes = null;
        let chartExpSuppliers = null;
        let chartExpiringUrgency = null;
        let chartExpiringTypes = null;

        // Tab Switching Handler
        function switchAdminTab(tabId, btn) {
            document.querySelectorAll('.dc-admin-tab-pane').forEach(p => p.style.display = 'none');
            document.querySelectorAll('.dc-tab-btn').forEach(b => b.classList.remove('active'));
            
            const targetPane = document.getElementById(tabId);
            if (targetPane) targetPane.style.display = 'block';

            let activeBtn = btn;
            if (!activeBtn || !activeBtn.classList) {
                if (tabId === 'complianceTab') activeBtn = document.getElementById('tabBtnCompliance');
                else if (tabId === 'expiredTab') activeBtn = document.getElementById('tabBtnExpired');
                else if (tabId === 'expiringTab') activeBtn = document.getElementById('tabBtnExpiring');
            }
            if (activeBtn) activeBtn.classList.add('active');
            currentTabId = tabId;

            // Trigger chart resize / update on tab view
            setTimeout(() => {
                if (tabId === 'complianceTab') {
                    if (chartCompDoughnut) chartCompDoughnut.resize();
                    if (chartCompBar) chartCompBar.resize();
                } else if (tabId === 'expiredTab') {
                    if (!chartExpTypes) initExpiredCharts();
                    else {
                        chartExpTypes.resize();
                        chartExpSuppliers.resize();
                    }
                } else if (tabId === 'expiringTab') {
                    if (!chartExpiringUrgency) initExpiringCharts();
                    else {
                        chartExpiringUrgency.resize();
                        chartExpiringTypes.resize();
                    }
                }
                if (window.lucide) lucide.createIcons();
            }, 50);
        }

        /* ----------------------------------------------------
           1. COMPLIANCE REPORT CONTROLLER (Strict 8 Items/Page)
           ---------------------------------------------------- */
        function initComplianceCharts() {
            const ctxDoughnut = document.getElementById('chartComplianceDoughnut').getContext('2d');
            const ctxBar = document.getElementById('chartComplianceBar').getContext('2d');

            const compliant = filteredCompList.filter(r => r.ComplianceStatus === 'Compliant').length;
            const nonCompliant = filteredCompList.filter(r => r.ComplianceStatus !== 'Compliant').length;

            chartCompDoughnut = new Chart(ctxDoughnut, {
                type: 'doughnut',
                data: {
                    labels: ['Compliant', 'Non-Compliant'],
                    datasets: [{
                        data: [compliant, nonCompliant],
                        backgroundColor: ['#10B981', '#EF4444'],
                        borderWidth: 2,
                        borderColor: '#FFFFFF',
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Inter', size: 12 } } },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${ctx.label}: ${ctx.raw} vendors (${Math.round(ctx.raw / (filteredCompList.length || 1) * 100)}%)`
                            }
                        }
                    }
                }
            });

            chartCompBar = new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: ['Compliant', 'Non-Compliant'],
                    datasets: [{
                        label: 'Suppliers',
                        data: [compliant, nonCompliant],
                        backgroundColor: ['#10B981', '#EF4444'],
                        borderRadius: 6,
                        maxBarThickness: 45
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#F1F5F9' }, ticks: { font: { family: 'Inter' } } },
                        x: { grid: { display: false }, ticks: { font: { family: 'Inter' } } }
                    }
                }
            });
        }

        function filterComplianceReport() {
            const query = (document.getElementById('compSearchInput').value || '').toLowerCase().trim();
            const statusFilter = document.getElementById('compStatusFilter').value;

            filteredCompList = rawComplianceData.filter(r => {
                const matchesQuery = !query || r.SupplierName.toLowerCase().includes(query);
                const matchesStatus = statusFilter === 'all' || r.ComplianceStatus === statusFilter;
                return matchesQuery && matchesStatus;
            });

            compCurrentPage = 1;
            renderComplianceTable();
            updateComplianceAnalytics();
        }

        function resetComplianceFilters() {
            document.getElementById('compSearchInput').value = '';
            document.getElementById('compStatusFilter').value = 'all';
            filterComplianceReport();
        }

        function updateComplianceAnalytics() {
            const total = filteredCompList.length;
            const compliant = filteredCompList.filter(r => r.ComplianceStatus === 'Compliant').length;
            const nonCompliant = total - compliant;
            const rate = total > 0 ? Math.round((compliant / total) * 100) : 0;

            document.getElementById('compKpiTotal').textContent = total;
            document.getElementById('compKpiCompliant').textContent = compliant;
            document.getElementById('compKpiNonCompliant').textContent = nonCompliant;
            document.getElementById('compKpiRate').textContent = `${rate}%`;

            if (chartCompDoughnut) {
                chartCompDoughnut.data.datasets[0].data = [compliant, nonCompliant];
                chartCompDoughnut.update();
            }
            if (chartCompBar) {
                chartCompBar.data.datasets[0].data = [compliant, nonCompliant];
                chartCompBar.update();
            }
        }

        function renderComplianceTable() {
            const tbody = document.getElementById('complianceTableBody');
            const totalItems = filteredCompList.length;
            const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

            if (compCurrentPage > totalPages) compCurrentPage = totalPages;
            if (compCurrentPage < 1) compCurrentPage = 1;

            const startIndex = (compCurrentPage - 1) * ITEMS_PER_PAGE;
            const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalItems);
            const pageSlice = filteredCompList.slice(startIndex, endIndex);

            if (pageSlice.length === 0) {
                tbody.innerHTML = `<tr><td colspan="2" style="text-align:center; padding:32px; color:var(--dc-text-muted);">No suppliers match the selected filter.</td></tr>`;
            } else {
                tbody.innerHTML = pageSlice.map(r => `
                    <tr>
                        <td>
                            <a href="/Admin/SupplierDetails?name=${encodeURIComponent(r.SupplierName)}" style="color:var(--dc-text-primary); font-weight:600; text-decoration:none;">
                                ${escapeHtml(r.SupplierName)}
                            </a>
                        </td>
                        <td>
                            <span class="dc-compliance-badge ${r.ComplianceStatus === 'Compliant' ? 'compliant' : 'not-compliant'}">
                                <span class="dc-status-dot"></span> ${escapeHtml(r.ComplianceStatus)}
                            </span>
                        </td>
                    </tr>
                `).join('');
            }

            const infoText = totalItems === 0 ? 'Showing 0–0 of 0' : `Showing ${startIndex + 1}–${endIndex} of ${totalItems}`;
            document.getElementById('compTableInfo').textContent = infoText;
            document.getElementById('compPageInfoText').textContent = infoText;

            renderPaginationButtons('compPageButtons', compCurrentPage, totalPages, (p) => {
                compCurrentPage = p;
                renderComplianceTable();
            });
        }

        /* ----------------------------------------------------
