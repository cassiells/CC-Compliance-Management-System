        function filterExpiredReport() {
            const query = (document.getElementById('expiredSearchInput').value || '').toLowerCase().trim();
            const docFilter = document.getElementById('expiredDocFilter').value;

            filteredExpList = rawExpiredData.filter(r => {
                const matchesQuery = !query || r.SupplierName.toLowerCase().includes(query) || (r.Document && r.Document.toLowerCase().includes(query));
                const matchesDoc = docFilter === 'all' || r.Document === docFilter;
                return matchesQuery && matchesDoc;
            });

            expCurrentPage = 1;
            renderExpiredTable();
            updateExpiredAnalytics();
        }

        function resetExpiredFilters() {
            document.getElementById('expiredSearchInput').value = '';
            document.getElementById('expiredDocFilter').value = 'all';
            filterExpiredReport();
        }

        function updateExpiredAnalytics() {
            const total = filteredExpList.length;
            const uniqueSuppliers = new Set(filteredExpList.map(r => r.SupplierName)).size;

            document.getElementById('expKpiTotal').textContent = total;
            document.getElementById('expKpiSuppliers').textContent = uniqueSuppliers;

            const typesMap = getCountsByField(filteredExpList, 'Document');
            const suppMap = getCountsByField(filteredExpList, 'SupplierName', 5);

            if (chartExpTypes) {
                chartExpTypes.data.labels = Object.keys(typesMap);
                chartExpTypes.data.datasets[0].data = Object.values(typesMap);
                chartExpTypes.update();
            }
            if (chartExpSuppliers) {
                chartExpSuppliers.data.labels = Object.keys(suppMap);
                chartExpSuppliers.data.datasets[0].data = Object.values(suppMap);
                chartExpSuppliers.update();
            }
        }

        function renderExpiredTable() {
            const tbody = document.getElementById('expiredTableBody');
            const totalItems = filteredExpList.length;
            const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

            if (expCurrentPage > totalPages) expCurrentPage = totalPages;
            if (expCurrentPage < 1) expCurrentPage = 1;

            const startIndex = (expCurrentPage - 1) * ITEMS_PER_PAGE;
            const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalItems);
            const pageSlice = filteredExpList.slice(startIndex, endIndex);

            if (pageSlice.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:32px; color:var(--dc-text-muted);">No expired documents match the filter criteria.</td></tr>`;
            } else {
                tbody.innerHTML = pageSlice.map(r => `
                    <tr>
                        <td>
                            <a href="/Admin/SupplierDetails?name=${encodeURIComponent(r.SupplierName)}" style="color:var(--dc-text-primary); font-weight:600; text-decoration:none;">
                                ${escapeHtml(r.SupplierName)}
                            </a>
                        </td>
                        <td>
                            <span class="dc-status-chip expired">
                                <span class="dc-status-dot"></span> ${escapeHtml(r.Document)}
                            </span>
                        </td>
                        <td style="color:var(--dc-text-secondary); font-size:13px;">
                            ${formatDateStr(r.ExpiryDate)}
                        </td>
                        <td style="text-align:right;">
                            <a href="/Admin/SupplierDetails?name=${encodeURIComponent(r.SupplierName)}" class="dc-btn dc-btn-secondary dc-btn-sm" style="padding:4px 10px; font-size:12px;">
                                View
                            </a>
                        </td>
                    </tr>
                `).join('');
            }

            const infoText = totalItems === 0 ? 'Showing 0–0 of 0' : `Showing ${startIndex + 1}–${endIndex} of ${totalItems}`;
            document.getElementById('expTableInfo').textContent = infoText;
            document.getElementById('expPageInfoText').textContent = infoText;

            renderPaginationButtons('expPageButtons', expCurrentPage, totalPages, (p) => {
                expCurrentPage = p;
                renderExpiredTable();
            });
        }

        /* ----------------------------------------------------
           3. EXPIRING DOCUMENTS CONTROLLER (Strict 8 Items/Page)
           ---------------------------------------------------- */
        function initExpiringCharts() {
            const ctxUrgency = document.getElementById('chartExpiringUrgencyDoughnut').getContext('2d');
            const ctxTypes = document.getElementById('chartExpiringTypesBar').getContext('2d');

            const criticalCount = filteredExpiringList.filter(r => getDaysUntil(r.ExpiryDate) <= 15).length;
            const upcomingCount = filteredExpiringList.length - criticalCount;
            const typesMap = getCountsByField(filteredExpiringList, 'Document');

            chartExpiringUrgency = new Chart(ctxUrgency, {
                type: 'doughnut',
                data: {
                    labels: ['Critical (≤ 15 Days)', 'Upcoming (16–30 Days)'],
                    datasets: [{
                        data: [criticalCount, upcomingCount],
                        backgroundColor: ['#EF4444', '#3B82F6'],
                        borderWidth: 2,
                        borderColor: '#FFFFFF',
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Inter', size: 12 } } }
                    }
                }
            });

            chartExpiringTypes = new Chart(ctxTypes, {
                type: 'bar',
                data: {
                    labels: Object.keys(typesMap),
                    datasets: [{
                        label: 'Expiring Count',
                        data: Object.values(typesMap),
                        backgroundColor: '#EAB308',
                        borderRadius: 6,
                        maxBarThickness: 38
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#F1F5F9' }, ticks: { font: { family: 'Inter' } } },
                        x: { grid: { display: false }, ticks: { font: { family: 'Inter' } } }
                    }
                }
            });
        }

        function filterExpiringReport() {
            const query = (document.getElementById('expiringSearchInput').value || '').toLowerCase().trim();
            const urgencyFilter = document.getElementById('expiringUrgencyFilter').value;
            const docFilter = document.getElementById('expiringDocFilter').value;

            filteredExpiringList = rawExpiringData.filter(r => {
                const matchesQuery = !query || r.SupplierName.toLowerCase().includes(query) || (r.Document && r.Document.toLowerCase().includes(query));
                const days = getDaysUntil(r.ExpiryDate);
                const matchesUrgency = urgencyFilter === 'all' || 
                                       (urgencyFilter === 'critical' && days <= 15) || 
                                       (urgencyFilter === 'upcoming' && days > 15);
                const matchesDoc = docFilter === 'all' || r.Document === docFilter;
                return matchesQuery && matchesUrgency && matchesDoc;
            });

            expiringCurrentPage = 1;
            renderExpiringTable();
            updateExpiringAnalytics();
        }

        function resetExpiringFilters() {
            document.getElementById('expiringSearchInput').value = '';
            document.getElementById('expiringUrgencyFilter').value = 'all';
            document.getElementById('expiringDocFilter').value = 'all';
            filterExpiringReport();
        }

        function updateExpiringAnalytics() {
            const total = filteredExpiringList.length;
            const critical = filteredExpiringList.filter(r => getDaysUntil(r.ExpiryDate) <= 15).length;
            const upcoming = total - critical;

            document.getElementById('expiringKpiTotal').textContent = total;
            document.getElementById('expiringKpiCritical').textContent = critical;
            document.getElementById('expiringKpiUpcoming').textContent = upcoming;

            const typesMap = getCountsByField(filteredExpiringList, 'Document');

            if (chartExpiringUrgency) {
                chartExpiringUrgency.data.datasets[0].data = [critical, upcoming];
                chartExpiringUrgency.update();
            }
            if (chartExpiringTypes) {
                chartExpiringTypes.data.labels = Object.keys(typesMap);
                chartExpiringTypes.data.datasets[0].data = Object.values(typesMap);
                chartExpiringTypes.update();
            }
        }

        function renderExpiringTable() {
            const tbody = document.getElementById('expiringTableBody');
            const totalItems = filteredExpiringList.length;
            const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

            if (expiringCurrentPage > totalPages) expiringCurrentPage = totalPages;
            if (expiringCurrentPage < 1) expiringCurrentPage = 1;

            const startIndex = (expiringCurrentPage - 1) * ITEMS_PER_PAGE;
            const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalItems);
            const pageSlice = filteredExpiringList.slice(startIndex, endIndex);

            if (pageSlice.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:32px; color:var(--dc-text-muted);">No expiring documents match the filter criteria.</td></tr>`;
            } else {
                tbody.innerHTML = pageSlice.map(r => {
                    const days = getDaysUntil(r.ExpiryDate);
                    const isCrit = days <= 15;
                    return `
                        <tr>
                            <td>
                                <a href="/Admin/SupplierDetails?name=${encodeURIComponent(r.SupplierName)}" style="color:var(--dc-text-primary); font-weight:600; text-decoration:none;">
                                    ${escapeHtml(r.SupplierName)}
                                </a>
                            </td>
                            <td>
                                <span class="dc-status-chip expiring-soon">
                                    <span class="dc-status-dot"></span> ${escapeHtml(r.Document)}
                                </span>
                            </td>
                            <td style="color:var(--dc-text-secondary); font-size:13px;">
                                ${formatDateStr(r.ExpiryDate)}
                            </td>
                            <td>
                                <span class="dc-status-chip ${isCrit ? 'expired' : 'expiring-soon'}" style="font-size:11px; padding:3px 8px;">
                                    ${days <= 0 ? 'Expiring Today' : (days + ' days remaining')}
                                </span>
                            </td>
                            <td style="text-align:right;">
                                <a href="/Admin/SupplierDetails?name=${encodeURIComponent(r.SupplierName)}" class="dc-btn dc-btn-secondary dc-btn-sm" style="padding:4px 10px; font-size:12px;">
                                    View
                                </a>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            const infoText = totalItems === 0 ? 'Showing 0–0 of 0' : `Showing ${startIndex + 1}–${endIndex} of ${totalItems}`;
            document.getElementById('expiringTableInfo').textContent = infoText;
            document.getElementById('expiringPageInfoText').textContent = infoText;

            renderPaginationButtons('expiringPageButtons', expiringCurrentPage, totalPages, (p) => {
                expiringCurrentPage = p;
                renderExpiringTable();
            });
        }

        /* ----------------------------------------------------
           4. COMMON REUSABLE PAGINATION CONTROLLER (Limit 8)
           ---------------------------------------------------- */
        function renderPaginationButtons(containerId, currentPage, totalPages, onPageClick) {
            const container = document.getElementById(containerId);
            if (!container) return;

            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }

            let html = '';

            // Previous Button
            html += `<button type="button" class="dc-page-btn" ${currentPage === 1 ? 'disabled style="opacity:0.4; cursor:not-allowed;"' : ''} data-page="${currentPage - 1}">Previous</button>`;

            // Page Number Buttons
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
                    html += `<button type="button" class="dc-page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
                } else if (i === currentPage - 2 || i === currentPage + 2) {
                    html += `<span style="padding:0 4px; color:var(--dc-text-muted);">…</span>`;
                }
            }

            // Next Button
            html += `<button type="button" class="dc-page-btn" ${currentPage === totalPages ? 'disabled style="opacity:0.4; cursor:not-allowed;"' : ''} data-page="${currentPage + 1}">Next</button>`;

            container.innerHTML = html;

            container.querySelectorAll('button[data-page]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const targetPage = parseInt(btn.getAttribute('data-page'), 10);
                    if (!isNaN(targetPage) && targetPage >= 1 && targetPage <= totalPages && targetPage !== currentPage) {
                        onPageClick(targetPage);
                    }
                });
            });
        }

        function getCountsByField(list, field, topN = null) {
            const map = {};
            list.forEach(item => {
                const val = item[field] || 'Unknown';
                map[val] = (map[val] || 0) + 1;
            });
            if (!topN) return map;

            const sortedKeys = Object.keys(map).sort((a, b) => map[b] - map[a]).slice(0, topN);
            const topMap = {};
            sortedKeys.forEach(k => topMap[k] = map[k]);
            return topMap;
        }

        function getDaysUntil(dateStr) {
            if (!dateStr) return 999;
            const target = new Date(dateStr);
            const now = new Date();
            const diffTime = target - now;
            return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        }

        function formatDateStr(dateStr) {
            if (!dateStr) return '—';
            const d = new Date(dateStr);
            return d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function exportCurrentReportPDF() {
            let reportType = 'compliance';
            let params = new URLSearchParams();

            if (currentTabId === 'expiredTab') {
                reportType = 'expired';
                const search = document.getElementById('expSearchInput')?.value?.trim() || '';
                if (search) params.append('search', search);
            } else if (currentTabId === 'expiringTab') {
                reportType = 'expiring';
                const search = document.getElementById('expiringSearchInput')?.value?.trim() || '';
                const range = document.getElementById('expiringRangeFilter')?.value || '';
                if (search) params.append('search', search);
                if (range && range !== 'all') params.append('range', range);
            } else {
                reportType = 'compliance';
                const search = document.getElementById('compSearchInput')?.value?.trim() || '';
                const status = document.getElementById('compStatusFilter')?.value || '';
                if (search) params.append('search', search);
                if (status && status !== 'all') params.append('status', status);
            }

            params.append('report', reportType);

            showToast(`Generating QuestPDF report for ${reportType.toUpperCase()}...`);
            window.location.href = `?handler=ExportPdf&${params.toString()}`;
        }

        function exportCurrentReportCSV() {
            let csv = '';
            let filename = '';

            if (currentTabId === 'complianceTab') {
                csv = "Supplier Name,Compliance Standing\n" + filteredCompList.map(r => `"${r.SupplierName}","${r.ComplianceStatus}"`).join('\n');
                filename = 'DoComply_Admin_Compliance_Report_8_per_page.csv';
            } else if (currentTabId === 'expiredTab') {
                csv = "Supplier Name,Document Credential,Status\n" + filteredExpList.map(r => `"${r.SupplierName}","${r.Document}","Expired"`).join('\n');
                filename = 'DoComply_Admin_Expired_Documents_Report.csv';
            } else {
                csv = "Supplier Name,Document Credential,Expiry Date\n" + filteredExpiringList.map(r => `"${r.SupplierName}","${r.Document}","${r.ExpiryDate}"`).join('\n');
                filename = 'DoComply_Admin_Expiring_Documents_Report.csv';
            }

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            a.click();
            URL.revokeObjectURL(url);
            showToast(`Exported ${filename} successfully!`);
        }

        // Initialize on DOM Ready
        document.addEventListener('DOMContentLoaded', () => {
            initComplianceCharts();
            renderComplianceTable();
            renderExpiredTable();
            renderExpiringTable();
            if (window.lucide) lucide.createIcons();

            // Tab button explicit click listeners
            document.getElementById('tabBtnCompliance')?.addEventListener('click', function() {
                switchAdminTab('complianceTab', this);
            });
            document.getElementById('tabBtnExpired')?.addEventListener('click', function() {
                switchAdminTab('expiredTab', this);
            });
            document.getElementById('tabBtnExpiring')?.addEventListener('click', function() {
                switchAdminTab('expiringTab', this);
            });

            // Check URL query param (?tab=expired or ?tab=expiring) or hash
            const urlParams = new URLSearchParams(window.location.search);
            const reqTab = (urlParams.get('tab') || window.location.hash.replace('#', '')).toLowerCase();
            if (reqTab === 'expired' || reqTab === 'expiredtab') {
                switchAdminTab('expiredTab', document.getElementById('tabBtnExpired'));
            } else if (reqTab === 'expiring' || reqTab === 'expiringtab') {
                switchAdminTab('expiringTab', document.getElementById('tabBtnExpiring'));
            }
        });
    </script>
}
