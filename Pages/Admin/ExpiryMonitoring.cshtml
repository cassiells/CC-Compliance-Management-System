@page
@model DoComply.Pages.Admin.ExpiryMonitoringModel
@{
    ViewData["Title"] = "Continuous Expiry Monitoring";
}

<div class="dc-page-header">
    <div class="dc-page-title-group">
        <div class="dc-breadcrumb">
            <a href="/Admin/Dashboard">Administrator</a> / <span>Expiry Monitoring</span>
        </div>
        <h1 class="dc-h1">Expiry Monitoring</h1>
        <p class="dc-body-secondary">CC checks document validity continuously—not just once.</p>
    </div>

    <!-- Prototype State Interactive Controls -->
    <div style="display:flex; align-items:center; gap:8px; background:#FFFFFF; padding:6px; border:1px solid var(--dc-border); border-radius:var(--dc-radius);">
        <span class="dc-caption" style="font-weight:600; padding:0 8px;">Simulate Document Expiry Transition:</span>
        <button type="button" class="dc-btn dc-btn-secondary dc-btn-sm" data-dc-expiry-state="Valid">
            Valid State
        </button>
        <button type="button" class="dc-btn dc-btn-primary dc-btn-sm" data-dc-expiry-state="Expiring Soon">
            Expiring Soon (Default)
        </button>
        <button type="button" class="dc-btn dc-btn-secondary dc-btn-sm" data-dc-expiry-state="Expired">
            Expired State
        </button>
    </div>
</div>

<!-- Interactive Live Demo Target Row Card -->
<div class="dc-card" style="margin-bottom: 24px; border-left: 4px solid var(--dc-orange-expiring-text);">
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;">
        <div>
            <div class="dc-caption" style="font-weight:600; text-transform:uppercase; letter-spacing:0.04em;">Selected Live Target</div>
            <h3 style="font-size:18px; font-weight:700; color:var(--dc-text-primary);">ABC Office Supplies — Tax Clearance</h3>
            <div style="font-size:13px; color:var(--dc-text-secondary); margin-top:4px;">Expiry Date: Oct. 15, 2026</div>
        </div>

        <div style="display:flex; align-items:center; gap:24px;">
            <div>
                <div class="dc-caption">Time Remaining</div>
                <div id="expiryDemoTimeRemaining" style="font-weight:700; font-size:15px; color:var(--dc-text-primary);">Expires in 30 days</div>
            </div>

            <div>
                <div class="dc-caption">Document Status</div>
                <div id="expiryDemoStatusChip">
                    <span class="dc-status-chip expiring-soon"><span class="dc-status-dot"></span> Expiring Soon</span>
                </div>
            </div>

            <div>
                <div class="dc-caption">Overall Supplier Badge</div>
                <div id="expiryDemoComplianceBadge">
                    <div class="dc-compliance-badge compliant">
                        <span class="dc-status-dot"></span> COMPLIANT
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Full Table -->
<div class="dc-table-container" data-dc-table-paginate="expiryTable" data-dc-per-page="12">
    <table class="dc-table" id="expiryTable">
        <thead>
            <tr>
                <th>Supplier</th>
                <th>Document</th>
                <th>Expiry</th>
                <th>Time Remaining</th>
                <th>Status</th>
                <th class="dc-table-action-col">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><strong>@item.SupplierName</strong></td>
                    <td>@item.DocumentName</td>
                    <td>@item.ExpiryDate</td>
                    <td style="font-weight:500;">@item.TimeRemaining</td>
                    <td>
                        <partial name="_StatusChip" model="item.Status" />
                    </td>
                    <td class="dc-table-action-col">
                        <button type="button" class="dc-btn dc-btn-secondary dc-btn-sm" onclick="showToast('Dispatched automated renewal reminder to @item.SupplierName')">
                            Notify Supplier
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="_Pagination" model="(Model.Items.Count, 12, 1)" />
</div>
