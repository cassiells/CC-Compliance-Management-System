@page
@model DoComply.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Administrator Dashboard";
}

<div class="dc-page-header">
    <div class="dc-page-title-group">
        <div class="dc-breadcrumb">
            <a href="/Admin/Dashboard">Administrator</a> / <span>Dashboard</span>
        </div>
        <h1 class="dc-h1">Good morning, @Model.AdminName</h1>
        <p class="dc-body-secondary">Here is the compliance position across your supplier network.</p>
    </div>
</div>

